{
  "manifest_version": 3,
  "name": "SWITCH",
  "version": "2.0.0",
  "description": "Switch any domain's outbound connections to a target backend, with cookies auto-injected.",

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SWITCH",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "options_page": "devtools.html",

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": [
    "cookies",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "webRequest"
  ],

  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "ws://*/*",
    "wss://*/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
